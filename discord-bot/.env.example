# Discord bot token (Developer Portal → Bot → Token)
DISCORD_TOKEN=your-discord-bot-token-here

# Supabase – use the SERVICE ROLE key (server-only, never expose in browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional bot version reported in heartbeat
BOT_VERSION=1.0.0

# --- Stream chat bot (sdílený bot účet) ---
# Twitch: username bot účtu + OAuth token (z https://twitchtokengenerator.com – scope: chat:read chat:edit moderator:manage:chat_messages moderator:manage:banned_users)
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=

# YouTube: bot Google účet (OAuth2 – scope: youtube.force-ssl)
YOUTUBE_BOT_CLIENT_ID=
YOUTUBE_BOT_CLIENT_SECRET=
YOUTUBE_BOT_REFRESH_TOKEN=
