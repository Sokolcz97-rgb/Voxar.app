{
  "name": "ashes-of-eryon-launcher",
  "productName": "Ashes of Eryon Launcher",
  "version": "0.3.0",
  "description": "Desktop launcher runtime for Ashes of Eryon",
  "author": "StudioVoxario",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check game-preload.cjs && node --check updater.cjs && node --check services.cjs && node --check ../prototype/prototype.js",
    "pack:win": "npm run check && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.studiovoxario.ashesoferyon.launcher",
    "productName": "Ashes of Eryon Launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "game-preload.cjs",
      "updater.cjs",
      "services.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../prototype",
        "to": "launcher-ui",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    }
  }
}
